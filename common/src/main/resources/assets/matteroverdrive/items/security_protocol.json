{
  "model": {
    "type": "minecraft:select",
    "property": "matteroverdrive:security_type",
    "cases": [
      {
        "when": 0,
        "model": {
          "type": "minecraft:model",
          "model": "matteroverdrive:item/security_protocol_empty"
        }
      },
      {
        "when": 1,
        "model": {
          "type": "minecraft:model",
          "model": "matteroverdrive:item/security_protocol_claim"
        }
      },
      {
        "when": 2,
        "model": {
          "type": "minecraft:model",
          "model": "matteroverdrive:item/security_protocol_access"
        }
      },
      {
        "when": 3,
        "model": {
          "type": "minecraft:model",
          "model": "matteroverdrive:item/security_protocol_remove"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "matteroverdrive:item/security_protocol_empty"
    }
  }
}
