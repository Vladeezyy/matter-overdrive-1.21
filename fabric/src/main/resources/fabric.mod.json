{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contributors": ["Vladeezyy"],
  "contact": {
    "sources": "${mod_sources}",
    "issues": "${mod_issues}"
  },
  "license": "${license}",
  "icon": "matteroverdrive_logo.png",
  "environment": "*",
  "entrypoints": {
    "fabric-gametest": ["matteroverdrive.fabric.FabricTransferTests"],
    "main": ["matteroverdrive.fabric.MatterOverdriveFabric"],
    "client": ["matteroverdrive.fabric.client.MatterOverdriveFabricClient"]
  },
  "mixins": ["matteroverdrive.fabric.mixins.json"],
  "accessWidener": "matteroverdrive.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_version}",
    "team_reborn_energy": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  }
}
